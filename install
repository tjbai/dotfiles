#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$ROOT/crypto"
shopt -s nullglob

# plaintext configs
cp "$ROOT/.zshrc" ~/.zshrc
cp "$ROOT/.tmux.conf" ~/.tmux.conf
mkdir -p ~/.config/zed ~/.config/nvim ~/.config/neovide ~/.config/ghostty
cp "$ROOT/.config/zed/settings.json" ~/.config/zed/settings.json
cp -r "$ROOT/.config/nvim/." ~/.config/nvim/
cp -r "$ROOT/.config/neovide/." ~/.config/neovide/
cp -r "$ROOT/.config/ghostty/." ~/.config/ghostty/

# amp: install the cli if missing, then restore settings + plugins
command -v amp >/dev/null || curl -fsSL https://ampcode.com/install.sh | bash
mkdir -p ~/.config/amp/plugins
cp "$ROOT/.config/amp/settings.json" ~/.config/amp/settings.json
cp -r "$ROOT/.config/amp/plugins/." ~/.config/amp/plugins/

# tmux: install if missing, plus resurrect/continuum (session durability)
if ! command -v tmux >/dev/null; then
  if command -v brew >/dev/null; then brew install tmux
  else echo "tmux: no homebrew — install tmux manually" >&2; fi
fi
mkdir -p ~/.tmux/plugins
[[ -d ~/.tmux/plugins/tmux-resurrect ]] || git clone --depth 1 https://github.com/tmux-plugins/tmux-resurrect ~/.tmux/plugins/tmux-resurrect
[[ -d ~/.tmux/plugins/tmux-continuum ]] || git clone --depth 1 https://github.com/tmux-plugins/tmux-continuum ~/.tmux/plugins/tmux-continuum

password

# skills: plaintext dirs copied, encrypted ones decrypted
dst=~/.config/agents/skills
mkdir -p "$dst"
for d in "$ROOT/skills"/*/; do
  name="$(basename "$d")"
  rm -rf "$dst/$name"
  cp -R "$d" "$dst/$name"
  echo "public: $name"
done
for f in "$ROOT/skills"/*.enc; do
  name="$(basename "$f" .enc)"
  rm -rf "$dst/$name"
  if ! enc -d -in "$f" 2>/dev/null | tar -xzf - -C "$dst"; then
    echo "failed to decrypt $name — wrong password?" >&2; exit 1
  fi
  echo "encrypted: $name"
done

# firefox: restore bookmarks + search shortcuts. needs firefox closed so it
# doesn't clobber the files on quit. bookmarks import once on next launch.
if pgrep -xq firefox; then
  echo "firefox is running — quit it and re-run ./install to restore bookmarks" >&2
elif ffdir="$(ffprofile)"; then
  if [[ -f "$ROOT/vault/firefox/bookmarks.html.enc" ]]; then
    if ! enc -d -in "$ROOT/vault/firefox/bookmarks.html.enc" -out "$ffdir/bookmarks.html" 2>/dev/null; then
      echo "failed to decrypt bookmarks — wrong password?" >&2; exit 1
    fi
    impref='user_pref("browser.places.importBookmarksHTML", true);'
    grep -qsF "$impref" "$ffdir/prefs.js" || printf '%s\n' "$impref" >> "$ffdir/prefs.js"
    echo "firefox: bookmarks (import on next launch)"
  fi
  if [[ -f "$ROOT/vault/firefox/search.json.mozlz4.enc" ]]; then
    if ! enc -d -in "$ROOT/vault/firefox/search.json.mozlz4.enc" -out "$ffdir/search.json.mozlz4" 2>/dev/null; then
      echo "failed to decrypt search shortcuts — wrong password?" >&2; exit 1
    fi
    echo "firefox: search shortcuts"
  fi
  autopref='user_pref("browser.bookmarks.autoExportHTML", true);'
  grep -qsF "$autopref" "$ffdir/user.js" || printf '%s\n' "$autopref" >> "$ffdir/user.js"
else
  echo "firefox: no profile — open firefox once, quit it, re-run ./install" >&2
fi

# raycast: install if missing, then hand the config to raycast for import.
# import is interactive — raycast asks for its own export passphrase
# (separate from the dotfiles password) and shows a category checklist.
if [[ ! -d /Applications/Raycast.app && ! -d ~/Applications/Raycast.app ]]; then
  if command -v brew >/dev/null; then
    brew install --cask raycast
    echo "raycast: installed"
  else
    echo "raycast: no homebrew — install raycast manually, then re-run ./install" >&2
  fi
fi
if [[ -f "$ROOT/vault/raycast/raycast.rayconfig.enc" ]]; then
  raycfg=~/Downloads/dotfiles-restore.rayconfig
  if ! enc -d -in "$ROOT/vault/raycast/raycast.rayconfig.enc" -out "$raycfg" 2>/dev/null; then
    echo "failed to decrypt raycast config — wrong password?" >&2; exit 1
  fi
  open "$raycfg" 2>/dev/null || true
  echo "raycast: import opened — enter raycast's export passphrase, then delete $raycfg"
fi

# private files
while IFS= read -r path; do
  f="$ROOT/vault/private/$path.enc"
  [[ -f "$f" ]] || { echo "missing: $f" >&2; continue; }
  mkdir -p "$(dirname ~/"$path")"
  if ! enc -d -in "$f" -out ~/"$path" 2>/dev/null; then
    echo "failed to decrypt $path — wrong password?" >&2; exit 1
  fi
  chmod 600 ~/"$path" || true
  echo "private: $path"
done < <(private)
