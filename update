#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$ROOT/crypto"
shopt -s nullglob

# plaintext configs
rm -f "$ROOT/.zshrc" "$ROOT/.tmux.conf"
rm -rf "$ROOT/.config/zed" "$ROOT/.config/nvim" "$ROOT/.config/neovide" "$ROOT/.config/ghostty" "$ROOT/.config/amp"
cp ~/.zshrc "$ROOT/.zshrc"
cp ~/.tmux.conf "$ROOT/.tmux.conf"
mkdir -p "$ROOT/.config/zed" && cp ~/.config/zed/settings.json "$ROOT/.config/zed/settings.json"
mkdir -p "$ROOT/.config/nvim" && cp -r ~/.config/nvim/* "$ROOT/.config/nvim/"
mkdir -p "$ROOT/.config/neovide" && cp -r ~/.config/neovide/* "$ROOT/.config/neovide/"
mkdir -p "$ROOT/.config/ghostty" && cp -r ~/.config/ghostty/* "$ROOT/.config/ghostty/"

# amp: settings + hand-written plugins. plugins amp auto-updates from
# ampcode.com (marked on line 1) restore themselves, so they stay out.
mkdir -p "$ROOT/.config/amp/plugins"
cp ~/.config/amp/settings.json "$ROOT/.config/amp/settings.json"
for f in ~/.config/amp/plugins/*.ts ~/.config/amp/plugins/*.js; do
  head -1 "$f" | grep -qF '@amp-plugin updated automatically' && continue
  cp "$f" "$ROOT/.config/amp/plugins/"
done

# amp publish: mirror local skills + plugins into the amp user repos
# (ampcode.com git), which every amp session — this machine, runners, fresh
# orbs — syncs from. local is the source of truth: skills/plugins that exist
# only in the amp repo get deleted here. skills land under their frontmatter
# name (the repo requires dir name == name); dirs without SKILL.md are
# skipped. plugins mirror everything local, auto-updated ones included, since
# orbs have no other way to get them. needs no password; skipped quietly
# when amp is missing or unauthenticated.
amprepo() { # amprepo <clone-dir> <url> — fresh checkout of origin/main
  if [[ ! -d "$1/.git" ]]; then
    git init -q -b main "$1"
    git -C "$1" config credential.helper '!amp git-credential-helper'
    git -C "$1" remote add origin "$2"
  fi
  git -C "$1" fetch -q origin main && git -C "$1" reset -q --hard origin/main
}
amppush() { # amppush <clone-dir> <message>
  git -C "$1" add -A
  git -C "$1" diff --cached --quiet && return 0
  git -C "$1" commit -q -m "$2"
  git -C "$1" push -q origin main 2>/dev/null
  echo "amp: pushed ${1##*-}"
}
if command -v amp >/dev/null \
   && skills_url="$(amp skills repositories 2>/dev/null | awk '/^User Skills/{f=1;next} f&&/https:/{print $1;exit}')" \
   && [[ -n "$skills_url" ]]; then
  src="$(skillsrc)"
  # keep the orb-installable zshrc inside installing-dotfiles current
  [[ -d "$src/installing-dotfiles/dotfiles" ]] && cp ~/.zshrc "$src/installing-dotfiles/dotfiles/zshrc"

  clone="$HOME/.cache/amp/repositories/ampcode.com-user-skills"
  if amprepo "$clone" "$skills_url"; then
    keep=" "
    for dir in "$src"/*/; do
      [[ -f "$dir/SKILL.md" ]] || continue
      fname="$(awk -F': *' '/^name:/{print $2;exit}' "$dir/SKILL.md")"
      [[ -n "$fname" ]] || { echo "amp: $(basename "$dir") has no frontmatter name, skipped" >&2; continue; }
      keep+="$fname "
      mkdir -p "$clone/$fname"
      rsync -a --delete --exclude .DS_Store "$dir" "$clone/$fname/"
    done
    for d in "$clone"/*/; do
      fname="$(basename "$d")"
      [[ "$keep" == *" $fname "* ]] || rm -rf "$d"
    done
    amppush "$clone" "sync skills"
  fi

  plugins_url="$(amp plugins repositories 2>/dev/null | awk '/^User Plugins/{f=1;next} f&&/https:/{print $1;exit}')"
  clone="$HOME/.cache/amp/repositories/ampcode.com-user-plugins"
  if [[ -n "$plugins_url" ]] && amprepo "$clone" "$plugins_url"; then
    find "$clone" -maxdepth 1 -type f \( -name '*.ts' -o -name '*.js' \) -delete
    cp ~/.config/amp/plugins/*.ts ~/.config/amp/plugins/*.js "$clone/" 2>/dev/null || true
    amppush "$clone" "sync plugins"
  fi
else
  echo "amp: not authenticated, skipping skills/plugins publish" >&2
fi

password confirm

# skills: names always public. content public only if listed in public.txt,
# otherwise encrypted to skills/<name>.enc.
src="$(skillsrc)"
mkdir -p "$ROOT/skills"
pub=" $(public | tr '\n' ' ')"
keep=" "
for dir in "$src"/*/; do
  name="$(basename "$dir")"
  keep+="$name "
  if [[ "$pub" == *" $name "* ]]; then
    rm -f "$ROOT/skills/$name.enc"
    rm -rf "$ROOT/skills/$name"
    cp -R "$dir" "$ROOT/skills/$name"
    echo "public: $name"
    continue
  fi
  rm -rf "$ROOT/skills/$name"
  out="$ROOT/skills/$name.enc"
  if [[ -f "$out" ]]; then
    old="$(mktemp -d)"
    if enc -d -in "$out" 2>/dev/null | tar -xzf - -C "$old" 2>/dev/null \
       && diff -qr "$old/$name" "$dir" >/dev/null 2>&1; then
      rm -rf "$old"; continue
    fi
    rm -rf "$old"
  fi
  tar -czf - -C "$src" "$name" | enc -e -out "$out"
  echo "encrypted: $name"
done
for out in "$ROOT/skills"/*.enc; do
  name="$(basename "$out" .enc)"
  [[ "$keep" == *" $name "* ]] || { rm -f "$out"; echo "dropped: $name"; }
done
for d in "$ROOT/skills"/*/; do
  name="$(basename "$d")"
  [[ "$keep" == *" $name "* ]] || { rm -rf "$d"; echo "dropped: $name"; }
done

# firefox: bookmarks + search shortcuts, encrypted (they reveal work).
# browser.bookmarks.autoExportHTML makes firefox write bookmarks.html on
# every quit; first run needs a firefox restart before there's anything to grab.
if ffdir="$(ffprofile)"; then
  autopref='user_pref("browser.bookmarks.autoExportHTML", true);'
  if ! grep -qsF "$autopref" "$ffdir/user.js"; then
    printf '%s\n' "$autopref" >> "$ffdir/user.js"
    echo "firefox: enabled bookmark export — restart firefox, then re-run ./update"
  fi
  mkdir -p "$ROOT/vault/firefox"
  for f in bookmarks.html search.json.mozlz4; do
    src="$ffdir/$f"
    [[ -f "$src" ]] || { echo "firefox: no $f yet (quit firefox to generate)" >&2; continue; }
    out="$ROOT/vault/firefox/$f.enc"
    if [[ -f "$out" ]] && enc -d -in "$out" 2>/dev/null | cmp -s - "$src"; then
      continue
    fi
    enc -e -in "$src" -out "$out"
    echo "firefox: $f"
  done
else
  echo "firefox: no profile found, skipping" >&2
fi

# raycast: settings export (.rayconfig), re-encrypted with our password.
# raycast has no headless export — run "Export Settings & Data" in raycast
# (or: open 'raycast://extensions/raycast/raycast/export-settings-data'),
# save to ~/Downloads or ~/Desktop, then re-run ./update.
newest=""
for f in ~/Downloads/*.rayconfig ~/Desktop/*.rayconfig; do
  [[ -z "$newest" || "$f" -nt "$newest" ]] && newest="$f"
done
if [[ -n "$newest" ]]; then
  mkdir -p "$ROOT/vault/raycast"
  out="$ROOT/vault/raycast/raycast.rayconfig.enc"
  if ! { [[ -f "$out" ]] && enc -d -in "$out" 2>/dev/null | cmp -s - "$newest"; }; then
    enc -e -in "$newest" -out "$out"
    echo "raycast: $(basename "$newest")"
  fi
elif [[ ! -f "$ROOT/vault/raycast/raycast.rayconfig.enc" ]]; then
  echo "raycast: no .rayconfig found — run 'Export Settings & Data' in raycast, then re-run ./update" >&2
fi

# private files
mkdir -p "$ROOT/vault/private"
while IFS= read -r path; do
  [[ -f ~/"$path" ]] || { echo "missing: ~/$path" >&2; continue; }
  out="$ROOT/vault/private/$path.enc"
  if [[ -f "$out" ]] && enc -d -in "$out" 2>/dev/null | cmp -s - ~/"$path"; then
    continue
  fi
  mkdir -p "$(dirname "$out")"
  enc -e -in ~/"$path" -out "$out"
  echo "private: $path"
done < <(private)
