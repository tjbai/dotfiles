#!/usr/bin/env bash
# doctor hook: is the running runner on the installed amp binary?
#
# amp self-updates (amp.runner.autoUpdate.enabled): it downloads the new binary
# to ~/.amp/bin/amp by rename, then once idle re-execs itself in place, so the
# pid and process start time do not change. comparing mtime to start time
# therefore lies; compare the inode the process actually mapped instead.
set -u
label="gui/$(id -u)/com.tjbai.amp-runner"
# -a: pgrep skips its own ancestors by default, and the runner is one when doctor
# runs from a runner thread. take the amp child of the launchd-managed wrapper;
# fall back to the command line, anchored so a parent shell can't match.
lpid="$(launchctl print "$label" 2>/dev/null | awk '$1=="pid" && $2=="=" {print $3; exit}')"
pid="$([[ -n "$lpid" ]] && pgrep -a -P "$lpid" -x amp | head -1)"
[[ -n "$pid" ]] || pid="$(pgrep -af '^[^ ]*/amp --no-tui --runner-id work' | head -1)"
[[ -n "$pid" ]] || { echo "runner process not found"; exit 1; }
bin="$HOME/.amp/bin/amp"
running="$(lsof -p "$pid" 2>/dev/null | awk -v b="$bin" '$4=="txt" && $NF==b {print $8; exit}')"
[[ -n "$running" ]] || { echo "could not read mapped binary for pid $pid"; exit 1; }
installed="$(stat -f %i "$bin")"
if [[ "$running" != "$installed" ]]; then
  echo "amp updated $(date -r "$(stat -f %m "$bin")" '+%m-%d %H:%M') but runner still on the old binary — amp restarts itself once idle, at most every 12h"
  exit 1
fi
echo "runner on current amp ($(amp --version 2>/dev/null | cut -d' ' -f1))"
