#!/usr/bin/env python3
"""fold scratch's inbox branch into main.

every scratch checkout — orbs, the vault on this machine, the laptop — commits
and pushes to `inbox` as it goes. this job rewrites that stream onto `main` as
one commit per (closed 4h UTC window, project dir), then re-parents whatever is
left of inbox onto the new main and force-updates inbox. main is only ever
written here. protocol: ~/.config/agents/skills/using-scratch/SKILL.md

  run              fold closed windows (what launchd runs hourly)
  run --all        also fold the still-open window
  run --dry-run    print the plan, push nothing
  run --repo DIR   use another checkout (default ~/auctor/scratch)

a "project dir" is the first two path components (auctor/bounded-reads); a
top-level dotdir (.trash, .obsidian) or a file directly under an area folds by
its first component; root files fold as ".". a commit that touches several
project dirs keeps them together in one folded commit so renames stay renames.

nothing is pushed until the folded tree is byte-identical to the inbox tree it
replaces. re-running after a partial failure is safe: already-folded windows
produce no-op groups and are skipped.
"""
import os
import subprocess
import sys
import time
from datetime import datetime, timezone

WINDOW_H = 4
WINDOW_S = WINDOW_H * 3600
REPO = os.path.expanduser("~/auctor/scratch")
NULL = "0" * 40


def log(msg):
    print(msg, flush=True)


def die(msg):
    print(f"error: {msg}", file=sys.stderr, flush=True)
    sys.exit(1)


def run(*args, env=None, input=None):
    e = os.environ.copy()
    if env:
        e.update(env)
    return subprocess.run(["git", "-C", REPO, *args], env=e, input=input, text=True,
                          capture_output=True)


def git(*args, env=None, input=None):
    r = run(*args, env=env, input=input)
    if r.returncode != 0:
        die(f"git {' '.join(args)}: {r.stderr.strip()}")
    return r.stdout.rstrip("\n")


def ok(*args):
    return run(*args).returncode == 0


class Commit:
    def __init__(self, line):
        # H ct an ae aI cn ce cI parents
        f = line.split("\x1f")
        self.sha, self.ct = f[0], int(f[1])
        self.an, self.ae, self.aI, self.cn, self.ce, self.cI = f[2:8]
        self.parents = f[8].split()
        self.subject = git("log", "-1", "--format=%s", self.sha)
        self.files = [p for p in git("diff-tree", "--no-commit-id", "--no-renames",
                                     "-r", "--name-only", self.sha).split("\n") if p]
        self.keys = sorted({key_of(p) for p in self.files})

    def env(self, committer=False):
        e = {"GIT_AUTHOR_NAME": self.an, "GIT_AUTHOR_EMAIL": self.ae, "GIT_AUTHOR_DATE": self.aI}
        if committer:
            e.update({"GIT_COMMITTER_NAME": self.cn, "GIT_COMMITTER_EMAIL": self.ce,
                      "GIT_COMMITTER_DATE": self.cI})
        return e


def key_of(path):
    parts = path.split("/")
    if len(parts) == 1:
        return "."
    if parts[0].startswith(".") or len(parts) == 2:
        return parts[0]
    return "/".join(parts[:2])


def window_label(idx):
    start = datetime.fromtimestamp(idx * WINDOW_S, timezone.utc)
    end = datetime.fromtimestamp((idx + 1) * WINDOW_S, timezone.utc)
    return f"{start:%Y-%m-%d %H:%M}–{end:%H:%M}Z"


def load_commits(rng):
    fmt = "%H\x1f%ct\x1f%an\x1f%ae\x1f%aI\x1f%cn\x1f%ce\x1f%cI\x1f%P"
    out = git("rev-list", "--reverse", f"--format={fmt}", "--no-commit-header", rng)
    return [Commit(l) for l in out.split("\n") if l]


def group_window(commits):
    """union commits sharing a project dir; groups ordered by first commit."""
    groups = []  # [set(keys), [commits]]
    for c in commits:
        hit = [g for g in groups if g[0] & set(c.keys)]
        merged = [set(c.keys), [c]]
        for g in hit:
            merged[0] |= g[0]
            merged[1] = g[1] + merged[1]
            groups.remove(g)
        merged[1].sort(key=lambda x: commits.index(x))
        groups.append(merged)
    groups.sort(key=lambda g: commits.index(g[1][0]))
    return groups


def tree_of(sha):
    return git("rev-parse", f"{sha}^{{tree}}")


def fold_group(tip, end, keys, group, label):
    """one commit on tip whose files (those touched by the group) match `end`."""
    files = sorted({p for c in group for p in c.files})
    index = os.path.join(git("rev-parse", "--git-dir"), f"fold-index-{os.getpid()}")
    env = {"GIT_INDEX_FILE": index}
    try:
        git("read-tree", tip, env=env)
        present = git("ls-tree", "-r", "--format=%(objectmode) %(objectname)\t%(path)",
                      end, "--", *files)
        seen = {l.split("\t", 1)[1] for l in present.split("\n") if l}
        info = [l for l in present.split("\n") if l]
        info += [f"0 {NULL}\t{p}" for p in files if p not in seen]
        git("update-index", "--index-info", env=env, input="\n".join(info) + "\n")
        tree = git("write-tree", env=env)
    finally:
        if os.path.exists(index):
            os.unlink(index)
    if tree == tree_of(tip):
        return None
    last = group[-1]
    if len(group) == 1:
        msg = git("log", "-1", "--format=%B", last.sha)
    else:
        msg = f"{'+'.join(sorted(keys))}: {len(group)} updates, {label}\n\n"
        msg += "\n".join(f"- {c.subject}" for c in group) + "\n"
    return git("commit-tree", tree, "-p", tip, "-m", msg, env=last.env())


def replay(parent, commits):
    """re-parent linear commits onto `parent`, reusing their trees verbatim."""
    for c in commits:
        msg = git("log", "-1", "--format=%B", c.sha)
        parent = git("commit-tree", tree_of(c.sha), "-p", parent, "-m", msg,
                     env=c.env(committer=True))
    return parent


def sync_vault(branch):
    if branch != "inbox":
        log(f"vault is on '{branch}', not inbox; not pulling")
        return
    gitdir = git("rev-parse", "--git-dir")
    if git("status", "--porcelain", "--untracked-files=no") \
            or os.path.exists(os.path.join(gitdir, "rebase-merge")):
        log("vault dirty; not pulling (run `git pull --rebase` in ~/auctor/scratch)")
        return
    r = run("pull", "--rebase", "--quiet")
    log("vault pulled" if r.returncode == 0 else f"vault pull failed: {r.stderr.strip()}")


def main(argv):
    global REPO
    fold_all = "--all" in argv
    dry = "--dry-run" in argv
    if "--repo" in argv:
        REPO = os.path.abspath(argv[argv.index("--repo") + 1])
    if not os.path.isdir(os.path.join(REPO, ".git")):
        die(f"{REPO} is not a git checkout")

    git("fetch", "--quiet", "origin", "main", "inbox")
    main_sha = git("rev-parse", "origin/main")
    inbox_sha = git("rev-parse", "origin/inbox")
    if main_sha == inbox_sha:
        log("inbox == main; nothing to fold")
        sync_vault(git("rev-parse", "--abbrev-ref", "HEAD"))
        return
    if not ok("merge-base", "--is-ancestor", main_sha, inbox_sha):
        die("origin/inbox does not descend from origin/main; fix by hand")

    commits = load_commits(f"{main_sha}..{inbox_sha}")
    if any(len(c.parents) != 1 for c in commits):
        die("merge commit on inbox; rebase it flat by hand")

    # windows are contiguous runs along inbox: clamp so out-of-order clocks
    # can't interleave two windows (which would break the tree invariant).
    now_idx = int(time.time()) // WINDOW_S
    idx = 0
    for c in commits:
        idx = max(idx, c.ct // WINDOW_S)
        c.win = idx
    closed = commits if fold_all else [c for c in commits if c.win < now_idx]
    rest = commits[len(closed):]
    if not closed:
        log(f"{len(rest)} commit(s) on inbox, all in the open window; nothing to fold")
        sync_vault(git("rev-parse", "--abbrev-ref", "HEAD"))
        return

    tip = main_sha
    folded = 0
    for win in sorted({c.win for c in closed}):
        wc = [c for c in closed if c.win == win]
        end = wc[-1].sha
        label = window_label(win)
        for keys, group in group_window(wc):
            new = fold_group(tip, end, keys, group, label)
            if new is None:
                log(f"  {label}  {'+'.join(sorted(keys))}: already on main, skipped")
                continue
            folded += 1
            tip = new
            log(f"  {label}  {'+'.join(sorted(keys))}: {len(group)} -> {tip[:7]}")

    if tree_of(tip) != tree_of(closed[-1].sha):
        die("folded tree != inbox tree at window end; nothing pushed")
    if folded == 0:
        log("closed windows already folded; nothing to push")
        sync_vault(git("rev-parse", "--abbrev-ref", "HEAD"))
        return

    new_inbox = replay(tip, rest)
    log(f"main: {main_sha[:7]} -> {tip[:7]} ({folded} commit(s) from {len(closed)}); "
        f"inbox keeps {len(rest)}")
    if dry:
        log("dry run; not pushing")
        return

    git("push", "--quiet", "origin", f"{tip}:refs/heads/main")
    for attempt in range(4):
        if ok("push", "--quiet", f"--force-with-lease=refs/heads/inbox:{inbox_sha}",
              "origin", f"{new_inbox}:refs/heads/inbox"):
            break
        # someone pushed to inbox meanwhile: fetch, re-parent the newcomers too.
        git("fetch", "--quiet", "origin", "inbox")
        moved = git("rev-parse", "origin/inbox")
        if not ok("merge-base", "--is-ancestor", inbox_sha, moved):
            die(f"inbox moved to {moved[:7]} and no longer descends from {inbox_sha[:7]}; "
                "main is folded, inbox untouched — rerun after inspecting")
        extra = load_commits(f"{inbox_sha}..{moved}")
        log(f"inbox moved by {len(extra)} commit(s) during fold; re-parenting (attempt {attempt + 1})")
        new_inbox = replay(new_inbox, extra)
        inbox_sha = moved
    else:
        die("could not update inbox after 4 attempts; main is folded, rerun")

    sync_vault(git("rev-parse", "--abbrev-ref", "HEAD"))


if __name__ == "__main__":
    main(sys.argv[1:])
