{
  "cli_default_open_behavior": "existing_window",
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "vim_mode": true,
  "relative_line_numbers": "enabled",
  "base_keymap": "VSCode",
  "ui_font_size": 12,
  "buffer_font_size": 11,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Gruvbox Dark Hard"
  },
  "show_edit_predictions": false,
  "language_servers": [
    "metals",
    "ocamllsp",
    "tsgo"
  ],
  "extend_comment_on_newline": false,
  "git": {
    "inline_blame": {
      "enabled": false
    }
  },
  "format_on_save": "off",
  "toolbar": {
    "breadcrumbs": true,
    "quick_actions": false,
    "selections_menu": false,
    "agent_review": false
  },
  "gutter": {
    "line_numbers": false,
    "code_actions": false,
    "folds": false,
    "min_line_number_digits": 0
  },
  "scrollbar": {
    "show": "never"
  },
  "features": {
    "copilot": false
  },
  "outline_panel": {
    "button": false
  },
  "collaboration_panel": {
    "button": false
  },
  "diagnostics": {
    "include_warnings": false
  },
  "agent": {
    "enabled": false,
    "button": false
  },
  "agent_servers": {
    "codex-acp": {
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry"
    },
    "devin": {
      "type": "registry"
    },
    "amp-acp": {
      "type": "registry"
    },
    "Devin": {
      "type": "custom",
      "command": "npx",
      "args": [
        "tsx",
        "/Users/bai/dev/devin-acp/src/index.ts"
      ],
      "env": {
        "DEVIN_REPOS": "auctor/auctor,auctor/sapiens"
      }
    }
  },
  "chat_panel": {
    "button": "never"
  },
  "notification_panel": {
    "button": false
  },
  "language_models": {
    "copilot_chat": null
  },
  "terminal": {
    "button": false,
    "env": {
      "AMP_FORCE_BEL": "1"
    }
  },
  "max_tabs": 1,
  "tab_bar": {
    "show": false,
    "show_nav_history_buttons": false,
    "show_tab_bar_buttons": false
  },
  "title_bar": {
    "show_onboarding_banner": false,
    "show_user_picture": false,
    "show_user_menu": false,
    "show_sign_in": false
  },
  "status_bar": {
    "experimental.show": false
  },
  "search": {
    "button": false
  },
  "debugger": {
    "button": false
  },
  "project_panel": {
    "button": false,
    "dock": "left",
    "indent_size": 16
  },
  "preferred_line_length": 160,
  "languages": {
    "Markdown": {
      "soft_wrap": "preferred_line_length",
      "preferred_line_length": 150,
      "remove_trailing_whitespace_on_save": true
    },
    "Python": {
      "language_servers": [
        "basedpyright",
        "ruff"
      ],
      "remove_trailing_whitespace_on_save": true
    },
    "TypeScript": {
      "language_servers": [
        "!tsgo",
        "vtsls",
        "..."
      ]
    },
    "TSX": {
      "language_servers": [
        "!tsgo",
        "vtsls",
        "..."
      ]
    },
    "JavaScript": {
      "language_servers": [
        "!tsgo",
        "vtsls",
        "..."
      ],
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": [
            "--stdin-filepath",
            "{buffer_path}"
          ]
        }
      }
    }
  },
  "lsp": {
    "tsgo": {
      "initialization_options": {
        "scriptKind": "auto"
      }
    }
  },
  "indent_guides": {
    "enabled": true
  },
  "remove_trailing_whitespace_on_save": false,
  "experimental.theme_overrides": {
    "background.appearance": "blurred",
    "editor.document_highlight.bracket_background": "#00000000",
    "editor.document_highlight.read_background": "#00000000",
    "editor.document_highlight.write_background": "#00000000"
  },
  "theme_overrides": {
    "Kanagawa Dragon": {
      "background": "#181616d9",
      "editor.background": "#18161600",
      "tab_bar.background": "#18161600",
      "tab.active_background": "#18161600",
      "tab.inactive_background": "#18161600",
      "title_bar.background": "#18161600",
      "toolbar.background": "#18161600",
      "panel.background": "#18161600",
      "terminal.background": "#18161600",
      "editor.gutter.background": "#18161600"
    },
    "Gruvbox Dark Hard": {
      "background": "#1d2021d9",
      "editor.background": "#1d202100",
      "tab_bar.background": "#1d202100",
      "tab.active_background": "#1d202100",
      "tab.inactive_background": "#1d202100",
      "title_bar.background": "#1d202100",
      "toolbar.background": "#1d202100",
      "panel.background": "#1d202100",
      "terminal.background": "#1d202100",
      "editor.gutter.background": "#1d202100"
    }
  },
  "disable_ai": true,
  "cargo": null,
  "active_pane_modifiers": {
    "border_size": 0,
    "inactive_opacity": 1
  },
  "cursor_blink": false
}
